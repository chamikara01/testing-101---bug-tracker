# ---------------------------------------------------------------------------
# Supabase — copy this file to `.env.local` and fill in values from your
# Supabase project: Dashboard → Project Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (SECRET — server only, never exposed to the browser).
# OPTIONAL: the app works without it. Only needed if you extend the app with
# admin-only server operations. Keep it out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email — OPTIONAL. Enables sending invitation emails with a join link. Without
# any provider, invites still work (the invitee accepts from their dashboard
# after signing in) — they just don't receive an email.
#
# Option A — Gmail SMTP (no domain needed; emails ANY recipient). On your Google
# account: enable 2-Step Verification → create an App Password → paste below.
# Takes priority over Resend when both are set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option B — Resend (https://resend.com → API Keys). The onboarding@resend.dev
# sender only delivers to your own Resend account email; verify a domain to
# email other people.
RESEND_API_KEY=
RESEND_FROM="Testing 101 <onboarding@resend.dev>"

# OPTIONAL: absolute site URL used to build invite join links. If unset, the
# request origin is used (fine for local dev). Set to your prod URL in prod.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Bug Capture Chrome extension — Claude proxy (server only).
# Powers /api/expand-bug, which the extension calls to turn a rough note into a
# structured bug report. The key stays server-side; never expose it to a browser.
# ---------------------------------------------------------------------------

# Anthropic API key (https://console.anthropic.com → API Keys). REQUIRED for the
# extension's "Draft with AI" step.
ANTHROPIC_API_KEY=

# OPTIONAL: override the model (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=

# OPTIONAL but recommended in production: lock CORS to your extension's origin,
# e.g. chrome-extension://<your-extension-id>. If unset, the route reflects any
# chrome-extension:// origin (fine for local dev; auth is still enforced by token).
EXTENSION_ORIGIN=
